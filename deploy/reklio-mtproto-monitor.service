[Unit]
Description=Reklio public Telegram post MTProto monitor
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/reklio/source
EnvironmentFile=/etc/reklio/mtproto-monitor.env
ExecStart=/opt/reklio/mtproto-venv/bin/python /opt/reklio/source/deploy/reklio_mtproto_monitor.py
Restart=on-failure
RestartSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
